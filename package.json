{
  "name": "hoist-the-elephant",
  "version": "0.1.0",
  "private": true,
  "description": "Release tooling for the Hoist the Elephant Agent Skill.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check:installed": "node scripts/sync-installed-skill.mjs check",
